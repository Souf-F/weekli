/**
 * Configuration du Worker Weekli.
 * Secrets (jamais dans ce fichier) :
 *   npx wrangler secret put GITHUB_CLIENT_ID
 *   npx wrangler secret put GITHUB_CLIENT_SECRET
 *   npx wrangler secret put COOKIE_ENCRYPTION_KEY
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "weekli",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WeekliMCP"] }],
  "durable_objects": {
    "bindings": [{ "class_name": "WeekliMCP", "name": "MCP_OBJECT" }]
  },
  // Limitation de debit : 60 appels d'API par minute et par utilisateur, 20 tentatives d'authentification par minute et par IP
  "ratelimits": [
    { "name": "LIMITE_API", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMITE_AUTH", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "LIMITE_CAPTURE", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ],
  // Navigateur headless (Browser Run) pour les captures de sites verifies
  "browser": { "binding": "BROWSER" },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "<Add-KV-ID>" }],
  // Le front React compile (apps/web/dist) est servi par le meme Worker.
  // Les routes dynamiques passent d'abord par le Worker, le reste tombe sur la SPA.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/mcp", "/mcp/*", "/authorize", "/token", "/register", "/callback", "/.well-known/*"]
  },
  // Adresse publique canonique du serveur (identifiant de ressource OAuth, RFC 9728).
  // En production : la remplacer par l'URL https du Worker avant de deployer.
  "vars": { "PUBLIC_URL": "http://localhost:8788" },
  "observability": { "enabled": true },
  "dev": { "port": 8788 }
}
