{
	"name": "@weekli/server",
	"version": "0.2.0",
	"private": true,
	"description": "Worker Cloudflare de Weekli : serveur MCP, OAuth GitHub, API du site et hebergement du front",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --ip 127.0.0.1 --port 8788",
		"deploy": "wrangler deploy",
		"typegen": "wrangler types --env-file .dev.vars.example",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"dev:docker": "wrangler dev --ip 0.0.0.0 --port 8788"
	},
	"dependencies": {
		"@cloudflare/codemode": "^0.5.5",
		"@cloudflare/workers-oauth-provider": "^1.2.4",
		"@modelcontextprotocol/client": "2.4.0",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@modelcontextprotocol/server": "2.4.0",
		"@weekli/core": "*",
		"agents": "^0.30.1",
		"hono": "^4.13.14",
		"octokit": "^5.0.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"vitest": "^5.0.5",
		"wrangler": "^4.152.0"
	}
}
