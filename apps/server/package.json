{
	"name": "@weekli/server",
	"version": "0.2.0",
	"private": true,
	"description": "Worker Cloudflare de Weekli : serveur MCP, OAuth GitHub, API du site et hebergement du front",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --ip 0.0.0.0 --port 8788",
