	"dependencies": {
		"@cloudflare/workers-oauth-provider": "^0.8.1",
		"@weekli/core": "*",
		"agents": "^0.17.1",
		"hono": "^4.12.27",
		"octokit": "^5.0.5",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260628.1",
		"wrangler": "^4.105.0"
	}
}
